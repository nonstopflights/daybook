# Node 22.13+; use an IANA timezone matching your Mac.
TZ=America/New_York
DAYBOOK_TIMEZONE=America/New_York
# Set before remote access. Blank permits local-only development.
APP_PASSWORD=
# Optional iMessage receiver: a long random token and the exact chat GUID.
IMESSAGE_TOKEN=
IMESSAGE_CHAT_GUID=
# Comma-separated BlueBubbles handle addresses allowed in that chat.
IMESSAGE_ALLOWED_SENDERS=
# Optional advanced interpretation via a local OpenAI-compatible endpoint.
# Example: http://127.0.0.1:11434/v1
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# PostgreSQL uses a dedicated "daybook" schema in this database. These are
# standard node-postgres/libpq settings; DATABASE_URL may be used instead.
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=daybook
PGDATABASE=daybook
PGPASSWORD=

